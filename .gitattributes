# Normalise les fins de ligne dans le dépôt (évite les avertissements CRLF/LF)
* text=auto eol=lf

# Fichiers Windows : conserver CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Fichiers binaires : ne jamais convertir
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pcap binary
*.pcapng binary
*.dll binary
*.exe binary
